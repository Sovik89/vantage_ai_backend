    embedding_vector = generate_embedding(embedding_text)
    
    if not embedding_vector:
        print(f"⚠️  Embedding generation failed for ATS learning")
        embedding_vector = []
    
    # Generate content hash for deduplication
    content_hash = hashlib.md5(f"{job_id}_{datetime.utcnow().date()}".encode()).hexdigest()[:12]
    
    # Insert into journal_vectors
    journal_row = {
