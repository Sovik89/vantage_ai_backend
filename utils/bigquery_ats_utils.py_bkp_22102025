def insert_ats_job(job_data: dict):
    """
    Insert ATS job metadata (NO candidate PII)
    """
    row = {
        "job_id": job_data.get("job_id"),
        "position_title": job_data.get("position_title"),
        "organization": job_data.get("organization"),
        "user_email": job_data.get("user_email"),  # Only client user
        "total_candidates_analyzed": job_data.get("total_candidates", 0),
        "status": job_data.get("status", "PENDING"),
        "created_at": job_data.get("created_at", datetime.utcnow().isoformat()),
        "updated_at": job_data.get("updated_at", datetime.utcnow().isoformat()),
        "record_date": job_data.get("record_date", datetime.utcnow().date().isoformat()),
        "record_date_str": job_data.get("record_date_str", datetime.utcnow().strftime("%d-%m-%Y")),
        "meta": job_data.get("meta", "{}"),
    }
    
    try:
        errors = client.insert_rows_json(ATS_JOBS_TABLE, [row])
        if errors:
            print(f"❌ Error inserting ATS job: {errors}")
            return False
        else:
            print(f"✅ Inserted ATS job: {row['job_id']}")
            return True
    except Exception as e:
        print(f"❌ Exception inserting ATS job: {e}")
        return False


def insert_aggregated_ats_results(job_id: str, results: list):
    """
    Insert AGGREGATED results only - NO individual candidate data
    
    Args:
        job_id: Job ID
        results: List of individual analysis results (used for aggregation only)
    """
    
    if not results:
        return False
    
    # Calculate aggregated statistics
    match_percentages = [r['overall_match_percentage'] for r in results]
    
    # Match distribution
    high_match = sum(1 for r in results if r['overall_match_percentage'] >= 70)
    medium_match = sum(1 for r in results if 50 <= r['overall_match_percentage'] < 70)
    low_match = sum(1 for r in results if r['overall_match_percentage'] < 50)
    
    # Skills aggregation
    all_missing_skills = []
    all_found_skills = []
    skills_matches = []
    for r in results:
        all_missing_skills.extend(r.get('skill_analysis', {}).get('missing_critical_skills', []))
        all_found_skills.extend(r.get('skill_analysis', {}).get('matched_required_skills', []))
        skills_matches.append(r.get('component_scores', {}).get('skills_match', 0))
    
    # Count occurrences and get most common
    from collections import Counter
    missing_counter = Counter(all_missing_skills)
    found_counter = Counter(all_found_skills)
    
    most_common_missing = [skill for skill, count in missing_counter.most_common(10)]
    most_common_found = [skill for skill, count in found_counter.most_common(10)]
    
    # Experience aggregation
    experience_matches = [r.get('component_scores', {}).get('experience_match', 0) for r in results]
    avg_candidate_years = sum(r.get('total_experience_years', 0) for r in results) / len(results)
    
    # AI detection aggregation
    ai_detected_count = sum(
        1 for r in results 
        if r.get('ai_generated_flags', {}).get('is_likely_ai_generated', False)
    )
    high_ai_risk = sum(
        1 for r in results 
        if r.get('ai_generated_flags', {}).get('warning_level', 'low') == 'high'
    )
    ai_probabilities = [
        r.get('ai_generated_flags', {}).get('ai_generated_probability', 0) 
        for r in results
    ]
    
    # Technical & Domain aggregation
    technical_depths = [r.get('component_scores', {}).get('technical_depth', 0) for r in results]
    domain_relevances = [r.get('component_scores', {}).get('domain_relevance', 0) for r in results]
    
    # Bias aggregation
    all_bias_flags = []
    for r in results:
        all_bias_flags.extend(r.get('bias_flags', []))
    bias_types = list(set(all_bias_flags))
    
    # Strengths and gaps aggregation (anonymized patterns)
    all_strengths = []
    all_gaps = []
    all_recommendations = []
    for r in results:
        all_strengths.extend(r.get('strengths', []))
        all_gaps.extend(r.get('gaps', []))
        all_recommendations.extend(r.get('recommendations', []))
    
    strength_counter = Counter(all_strengths)
    gap_counter = Counter(all_gaps)
    rec_counter = Counter(all_recommendations)
    
    common_strengths = [s for s, c in strength_counter.most_common(5)]
    common_gaps = [g for g, c in gap_counter.most_common(5)]
    key_recommendations = [r for r, c in rec_counter.most_common(5)]
    
    # Create summary
    summary = f"""
ATS Analysis Summary:
- Analyzed {len(results)} candidates
- Average match: {sum(match_percentages)/len(match_percentages):.1f}%
- High matches (≥70%): {high_match}
- AI-generated detected: {ai_detected_count}
- Most common missing skills: {', '.join(most_common_missing[:3])}
    """.strip()
    
    # Insert aggregated row
    row = {
        "result_id": str(hashlib.md5(f"{job_id}_{datetime.utcnow().isoformat()}".encode()).hexdigest()[:12]),
        "job_id": job_id,
        "created_at": datetime.utcnow().isoformat(),
        "record_date": datetime.utcnow().date().isoformat(),
        "record_date_str": datetime.utcnow().strftime("%d-%m-%Y"),
        
        # Aggregated statistics
        "total_candidates": len(results),
        "avg_match_percentage": sum(match_percentages) / len(match_percentages),
        "median_match_percentage": sorted(match_percentages)[len(match_percentages)//2],
        "max_match_percentage": max(match_percentages),
        "min_match_percentage": min(match_percentages),
        
        # Distribution
        "high_match_count": high_match,
        "medium_match_count": medium_match,
        "low_match_count": low_match,
        
        # Skills
        "avg_skills_match": sum(skills_matches) / len(skills_matches),
        "most_common_missing_skills": most_common_missing,
        "most_common_found_skills": most_common_found,
        
        # Experience
        "avg_experience_match": sum(experience_matches) / len(experience_matches),
        "avg_candidate_experience_years": avg_candidate_years,
        
        # AI Detection
        "ai_generated_detected_count": ai_detected_count,
        "avg_ai_probability": sum(ai_probabilities) / len(ai_probabilities),
        "high_ai_risk_count": high_ai_risk,
        
        # Technical & Domain
        "avg_technical_depth": sum(technical_depths) / len(technical_depths),
        "avg_domain_relevance": sum(domain_relevances) / len(domain_relevances),
        
        # Bias
        "total_bias_flags": len(all_bias_flags),
        "bias_types_detected": bias_types,
        
        # Insights
        "common_strengths": common_strengths,
        "common_gaps": common_gaps,
        "key_recommendations": key_recommendations,
        
        # Summary
        "analysis_summary": summary,
        "meta": json.dumps({"aggregated_from": len(results), "privacy_compliant": True}),
    }
    
    try:
        errors = client.insert_rows_json(ATS_RESULTS_TABLE, [row])
        if errors:
            print(f"❌ Error inserting aggregated results: {errors}")
            return False
        else:
            print(f"✅ Inserted aggregated ATS results for job: {job_id}")
            return True
    except Exception as e:
        print(f"❌ Exception inserting aggregated results: {e}")
        import traceback
        traceback.print_exc()
        return False


def insert_ats_learning_to_journal(job_id: str, jd_summary: dict, results_summary: dict):
    """
    Insert learning insights to journal_vectors table
    This creates knowledge from the ATS analysis without storing PII
    
    Args:
        job_id: Job ID
        jd_summary: Summary of JD requirements
        results_summary: Aggregated analysis summary
    """
    
    # Create learning summary
    learning_summary = {
        "analysis_type": "ats_recruitment",
        "job_id": job_id,
        "position_context": {
            "role_level": jd_summary.get('role_level', 'Unknown'),
            "domain": jd_summary.get('domain', 'Unknown'),
            "required_skills_count": len(jd_summary.get('required_skills', [])),
            "experience_required": jd_summary.get('experience_required', 0),
            "technical_areas": jd_summary.get('technical_areas', [])
        },
        "market_insights": {
            "total_candidates_analyzed": results_summary.get('total_candidates', 0),
            "avg_match_percentage": results_summary.get('avg_match_percentage', 0),
            "talent_availability": "high" if results_summary.get('high_match_count', 0) > results_summary.get('total_candidates', 1) * 0.3 else "medium" if results_summary.get('high_match_count', 0) > 0 else "low",
            "skills_gap_analysis": results_summary.get('most_common_missing_skills', [])[:5],
            "common_candidate_strengths": results_summary.get('common_strengths', [])[:5]
        },
        "ai_detection_insights": {
            "ai_generated_cv_rate": results_summary.get('ai_generated_detected_count', 0) / max(results_summary.get('total_candidates', 1), 1),
            "avg_ai_probability": results_summary.get('avg_ai_probability', 0),
            "high_risk_count": results_summary.get('high_ai_risk_count', 0)
        },
        "recruitment_recommendations": results_summary.get('key_recommendations', [])[:5],
        "timestamp": datetime.utcnow().isoformat()
    }
    
    # Generate AI summary for semantic search
    from utils.vertex_ai_utils import generate_freeform, generate_embedding
    
    ai_summary_prompt = f"""
Analyze this ATS recruitment analysis and provide insights for future hiring decisions.

Position Context:
- Role: {jd_summary.get('role_level')} level in {jd_summary.get('domain')}
- Required Skills: {', '.join(jd_summary.get('required_skills', [])[:10])}
- Experience: {jd_summary.get('experience_required')} years
- Technical Areas: {', '.join(jd_summary.get('technical_areas', []))}

Market Analysis:
- {results_summary.get('total_candidates', 0)} candidates analyzed
- Average match: {results_summary.get('avg_match_percentage', 0):.1f}%
- High matches: {results_summary.get('high_match_count', 0)}
- Common gaps: {', '.join(results_summary.get('most_common_missing_skills', [])[:5])}
- AI-generated CVs detected: {results_summary.get('ai_generated_detected_count', 0)}

Provide a 2-3 sentence insight about:
1. Talent market availability for this role
2. Key skill gaps to address
3. Recommendations for future recruitment

Insight:
"""
    
    try:
        ai_summary = generate_freeform(ai_summary_prompt).strip()
    except:
        ai_summary = f"ATS analysis for {jd_summary.get('role_level')} {jd_summary.get('domain')} role with {results_summary.get('total_candidates', 0)} candidates analyzed."
    
    # Generate embedding for semantic search
    embedding_text = f"""
ATS Recruitment Analysis
Role: {jd_summary.get('role_level')} in {jd_summary.get('domain')}
Skills: {', '.join(jd_summary.get('required_skills', [])[:15])}
Technical Areas: {', '.join(jd_summary.get('technical_areas', []))}
