def upsert_ats_candidate(candidate_data: dict, analysis_result: dict):
    """
    Insert or update candidate master record
    
    Args:
        candidate_data: Structured CV data
        analysis_result: Latest analysis result
    """
    import json
    import hashlib
    
    # Generate candidate ID from email
    email = candidate_data.get("email", "unknown@example.com")
    candidate_id = hashlib.md5(email.encode()).hexdigest()[:12]
    
    # Check if candidate exists
    query = f"""
    SELECT candidate_id, times_analyzed, average_match_score, best_match_score, 
           ai_detection_count, avg_ai_probability, first_analyzed
    FROM `{ATS_CANDIDATES_TABLE}`
    WHERE candidate_id = @candidate_id
    LIMIT 1
    """
    
    job_config = bigquery.QueryJobConfig(
        query_parameters=[
            bigquery.ScalarQueryParameter("candidate_id", "STRING", candidate_id)
        ]
    )
    
    try:
        results = list(client.query(query, job_config=job_config).result())
        
        now = datetime.utcnow().isoformat()
        
        if results:
            # Update existing candidate
            existing = dict(results[0])
            
            times_analyzed = existing.get("times_analyzed", 0) + 1
            current_match = analysis_result.get("overall_match_percentage", 0)
            avg_match = ((existing.get("average_match_score", 0) * existing.get("times_analyzed", 0)) + current_match) / times_analyzed
            best_match = max(existing.get("best_match_score", 0), current_match)
            
            ai_detection_count = existing.get("ai_detection_count", 0)
            if analysis_result.get("ai_generated_flags", {}).get("is_likely_ai_generated"):
                ai_detection_count += 1
            
            current_ai_prob = analysis_result.get("ai_generated_flags", {}).get("ai_generated_probability", 0)
            avg_ai_prob = ((existing.get("avg_ai_probability", 0) * existing.get("times_analyzed", 0)) + current_ai_prob) / times_analyzed
            
            # Use MERGE or UPDATE
            update_query = f"""
            UPDATE `{ATS_CANDIDATES_TABLE}`
            SET 
                candidate_name = @name,
                phone = @phone,
                current_company = @company,
                total_experience_years = @experience,
                skills = @skills,
                certifications = @certifications,
                education_json = @education,
                times_analyzed = @times_analyzed,
                average_match_score = @avg_match,
                best_match_score = @best_match,
                ai_detection_count = @ai_count,
                avg_ai_probability = @avg_ai,
                last_analyzed = @last_analyzed,
                updated_at = @updated_at,
                cv_structured_json = @cv_json
            WHERE candidate_id = @candidate_id
            """
            
            update_config = bigquery.QueryJobConfig(
                query_parameters=[
                    bigquery.ScalarQueryParameter("candidate_id", "STRING", candidate_id),
                    bigquery.ScalarQueryParameter("name", "STRING", candidate_data.get("name")),
                    bigquery.ScalarQueryParameter("phone", "STRING", candidate_data.get("phone")),
                    bigquery.ScalarQueryParameter("company", "STRING", candidate_data.get("current_company")),
                    bigquery.ScalarQueryParameter("experience", "FLOAT", float(candidate_data.get("total_experience", 0))),
                    bigquery.ArrayQueryParameter("skills", "STRING", candidate_data.get("skills", [])),
                    bigquery.ArrayQueryParameter("certifications", "STRING", candidate_data.get("certifications", [])),
                    bigquery.ScalarQueryParameter("education", "STRING", json.dumps(candidate_data.get("education", []))),
                    bigquery.ScalarQueryParameter("times_analyzed", "INT64", times_analyzed),
                    bigquery.ScalarQueryParameter("avg_match", "FLOAT", avg_match),
                    bigquery.ScalarQueryParameter("best_match", "FLOAT", best_match),
                    bigquery.ScalarQueryParameter("ai_count", "INT64", ai_detection_count),
                    bigquery.ScalarQueryParameter("avg_ai", "FLOAT", avg_ai_prob),
                    bigquery.ScalarQueryParameter("last_analyzed", "TIMESTAMP", now),
                    bigquery.ScalarQueryParameter("updated_at", "TIMESTAMP", now),
                    bigquery.ScalarQueryParameter("cv_json", "STRING", json.dumps(candidate_data)),
                ]
            )
            
            client.query(update_query, job_config=update_config).result()
            print(f"✅ Updated candidate: {candidate_data.get('name')}")
            
        else:
            # Insert new candidate
            row = {
                "candidate_id": candidate_id,
                "candidate_name": candidate_data.get("name"),
                "email": email,
                "phone": candidate_data.get("phone"),
                "current_company": candidate_data.get("current_company"),
                "total_experience_years": float(candidate_data.get("total_experience", 0)),
                "skills": candidate_data.get("skills", []),
                "certifications": candidate_data.get("certifications", []),
                "education_json": json.dumps(candidate_data.get("education", [])),
                "times_analyzed": 1,
                "average_match_score": float(analysis_result.get("overall_match_percentage", 0)),
                "best_match_score": float(analysis_result.get("overall_match_percentage", 0)),
                "best_match_position": analysis_result.get("job_id", ""),
                "ai_detection_count": 1 if analysis_result.get("ai_generated_flags", {}).get("is_likely_ai_generated") else 0,
                "avg_ai_probability": float(analysis_result.get("ai_generated_flags", {}).get("ai_generated_probability", 0)),
                "first_analyzed": now,
                "last_analyzed": now,
                "created_at": now,
                "updated_at": now,
                "cv_structured_json": json.dumps(candidate_data),
                "meta": json.dumps({}),
            }
            
            errors = client.insert_rows_json(ATS_CANDIDATES_TABLE, [row])
            if errors:
                print(f"❌ Error inserting candidate: {errors}")
                return False
            else:
                print(f"✅ Inserted new candidate: {row['candidate_name']}")
                return True
                
    except Exception as e:
        print(f"❌ Exception in upsert_candidate: {e}")
        import traceback
        traceback.print_exc()
        return False


def update_ats_job_status(job_id: str, status: str, **kwargs):
    """
    Update ATS job status
    
    Args:
        job_id: Job ID to update
        status: New status (PROCESSING, COMPLETED, FAILED)
        **kwargs: Additional fields to update
    """
    
    updates = [f"status = '{status}'", f"updated_at = CURRENT_TIMESTAMP()"]
    
    if status == "COMPLETED":
        updates.append("completed_at = CURRENT_TIMESTAMP()")
    
    if "error_message" in kwargs:
        updates.append(f"error_message = '{kwargs['error_message']}'")
    
    if "report_url" in kwargs:
        updates.append(f"report_url = '{kwargs['report_url']}'")
    
    if "total_candidates" in kwargs:
        updates.append(f"total_candidates = {kwargs['total_candidates']}")
    
    query = f"""
    UPDATE `{ATS_JOBS_TABLE}`
    SET {', '.join(updates)}
    WHERE job_id = '{job_id}'
    """
    
    try:
        client.query(query).result()
        print(f"✅ Updated job {job_id} status to: {status}")
        return True
    except Exception as e:
        print(f"❌ Error updating job status: {e}")
        return False


