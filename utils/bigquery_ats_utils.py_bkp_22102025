def update_ats_job_status(job_id: str, status: str, **kwargs):
    """Update ATS job status"""
    
    updates = [f"status = '{status}'", "updated_at = CURRENT_TIMESTAMP()"]
    
    if status == "COMPLETED":
        updates.append("completed_at = CURRENT_TIMESTAMP()")
    
    if "error_message" in kwargs:
        error_msg = kwargs['error_message'].replace("'", "\\'")
        updates.append(f"error_message = '{error_msg}'")
    
    if "report_url" in kwargs:
        updates.append(f"report_url = '{kwargs['report_url']}'")
    
    if "total_candidates" in kwargs:
        updates.append(f"total_candidates_analyzed = {kwargs['total_candidates']}")
    
    query = f"""
    UPDATE `{ATS_JOBS_TABLE}`
    SET {', '.join(updates)}
    WHERE job_id = '{job_id}'
    """
    
    try:
        client.query(query).result()
        print(f"✅ Updated job {job_id} status to: {status}")
        return True
    except Exception as e:
        print(f"❌ Error updating job status: {e}")
        return False


# ==================== Query Functions ====================

def get_ats_job(job_id: str) -> dict:
    """Get ATS job by ID"""
    query = f"""
    SELECT *
    FROM `{ATS_JOBS_TABLE}`
    WHERE job_id = @job_id
    LIMIT 1
    """
    
    job_config = bigquery.QueryJobConfig(
        query_parameters=[
            bigquery.ScalarQueryParameter("job_id", "STRING", job_id)
        ]
    )
    
    try:
        results = list(client.query(query, job_config=job_config).result())
        return dict(results[0]) if results else None
    except Exception as e:
        print(f"❌ Error getting job: {e}")
        return None


def get_ats_aggregated_results(job_id: str) -> dict:
    """Get aggregated results for a job"""
    query = f"""
    SELECT *
